TIINGO_API_KEY=your_tiingo_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
FMP_API_KEY=your_fmp_api_key_here
MASSIVE_API_KEY=your_massive_api_key_here
# Massive news pacing (free tier ~5 req/min). Seconds between /reference/news calls.
# MASSIVE_NEWS_MIN_INTERVAL_SEC=12
# Live sentiment incremental refresh window (days) when cache is warm.
# FIRM_SENTIMENT_INCREMENTAL_DAYS=7
FINNHUB_API_KEY=your_finnhub_api_key_here
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
# SEC EDGAR (free fundamentals — no key; required User-Agent string)
SEC_EDGAR_USER_AGENT=your-app-name you@example.com
FRED_API_KEY=your_fred_api_key_here
# Danelfin AI stock-scoring API (see firm.data.providers.danelfin and
# docs/investing_pro_integration.md) — paid subscription, real REST API,
# not a scraper. https://apirest.danelfin.com, header auth (x-api-key).
DANELFIN_API_KEY=your_danelfin_api_key_here

# Investing.com Pro (no official API — authenticated web scraper, see
# firm.data.investing.session.InvestingSession and
# docs/investing_pro_integration.md). Requires a paid Investing.com Pro
# account. Master switch defaults OFF: with INVESTING_SCRAPER_ENABLED unset,
# none of this code touches the network and the system behaves exactly as
# without it. Scraping a login-gated account is very likely against
# Investing.com's Terms of Service — the practical risk is account
# suspension (their bot-detection), not legal, since it's your own paid
# login. Set INVESTING_SCRAPER_ENABLED=1 only once you've accepted that risk.
#
# --- Required for the default method (INVESTING_AUTH_METHOD=playwright) ---
# Also requires: pip install -e '.[investing]' && playwright install chromium
# INVESTING_SCRAPER_ENABLED=0
# INVESTING_EMAIL=you@example.com
# INVESTING_PASSWORD=your_investing_com_password
#
# --- Only used if you switch to INVESTING_AUTH_METHOD=endpoint instead ---
# (lighter-weight — no browser — but requires capturing the real login
# request from your browser's devtools Network tab first; this codebase
# does not fabricate third-party API details, so these are left blank):
# INVESTING_AUTH_METHOD=endpoint
# INVESTING_LOGIN_PAGE_URL=https://www.investing.com/<the real login page>
# INVESTING_LOGIN_POST_URL=https://www.investing.com/<the real POST endpoint>
# INVESTING_LOGIN_FIELD_MAP=email:<real email field name>,password:<real password field name>

# LLM providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alias for the same Google AI Studio key (LiteLLM reads GEMINI_API_KEY).
# GOOGLE_API_KEY=your_gemini_api_key_here
OLLAMA_HOST=http://localhost:11434

# RAG embeddings/reranking (sentiment/bull/bear research grounding) — free tier:
# 50M tokens for voyage-finance-2, 200M tokens for rerank-2.5. Not needed if
# rag.embedding_provider/reranker_provider are set to "local" in config/llm.yaml.
VOYAGE_API_KEY=your_voyage_api_key_here

# Live/paper trading – Alpaca
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true

# Live/paper trading – Interactive Brokers (TWS / Gateway)
# When running via docker compose, IBKR_HOST is overridden to the
# service name "ib-gateway" automatically — leave it as 127.0.0.1 for local runs.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_PAPER_PORT=4002
IBKR_CLIENT_ID=1

# Docker-only: credentials for the gnzsnz/ib-gateway headless container.
# These are NOT needed for a local setup where you log in manually.
IBKR_USERID=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password
IBKR_TRADING_MODE=paper          # paper | live
IBKR_VNC_PASSWORD=changeme       # VNC debug password (SSH-tunnel only, not exposed publicly)

# When ai-trading.service runs firm-api (not scripts/run_live_trading.py), set this
# to auto-start the live engine from config/live.yaml on API boot.
FIRM_AUTO_START_LIVE=0

# Execution-safety hard lock (firm.live.execution_safety). A LIVE broker
# (ibkr / ibkr_live / alpaca_live) will NOT submit orders unless this is set to
# 1 in the service environment — a human-only switch on top of the approval
# queue. Paper brokers ignore it. Default (unset/0) = live routing blocked.
FIRM_ALLOW_TRADING=0
# Optional: override the execution-safety audit log path (default data/execution_audit.jsonl)
# FIRM_EXECUTION_AUDIT=data/execution_audit.jsonl

# Real-time alert delivery (firm.live.notifications). Unset = alerts are only
# logged and surfaced via GET /api/live/alerts (dashboard polling), matching
# prior behavior. Set ALERT_WEBHOOK_URL to push kill-switch trips,
# live_trading_locked blocks, etc. to Slack/Teams/Discord/generic webhooks.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# ALERT_MIN_SEVERITY=warning   # "warning" (default) or "critical"
# ALERT_WEBHOOK_TIMEOUT=5

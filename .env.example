TIINGO_API_KEY=your_tiingo_api_key_here
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here
FMP_API_KEY=your_fmp_api_key_here
MASSIVE_API_KEY=your_massive_api_key_here
FRED_API_KEY=your_fred_api_key_here

# LLM providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_HOST=http://localhost:11434

# RAG embeddings/reranking (sentiment/bull/bear research grounding) — free tier:
# 50M tokens for voyage-finance-2, 200M tokens for rerank-2.5. Not needed if
# rag.embedding_provider/reranker_provider are set to "local" in config/llm.yaml.
VOYAGE_API_KEY=your_voyage_api_key_here

# Live/paper trading – Alpaca
ALPACA_API_KEY=your_alpaca_key
ALPACA_SECRET_KEY=your_alpaca_secret
ALPACA_PAPER=true

# Live/paper trading – Interactive Brokers (TWS / Gateway)
# When running via docker compose, IBKR_HOST is overridden to the
# service name "ib-gateway" automatically — leave it as 127.0.0.1 for local runs.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_PAPER_PORT=4002
IBKR_CLIENT_ID=1

# Docker-only: credentials for the gnzsnz/ib-gateway headless container.
# These are NOT needed for a local setup where you log in manually.
IBKR_USERID=your_ibkr_username
IBKR_PASSWORD=your_ibkr_password
IBKR_TRADING_MODE=paper          # paper | live
IBKR_VNC_PASSWORD=changeme       # VNC debug password (SSH-tunnel only, not exposed publicly)

# When ai-trading.service runs firm-api (not scripts/run_live_trading.py), set this
# to auto-start the live engine from config/live.yaml on API boot.
FIRM_AUTO_START_LIVE=0

# Execution-safety hard lock (firm.live.execution_safety). A LIVE broker
# (ibkr / ibkr_live / alpaca_live) will NOT submit orders unless this is set to
# 1 in the service environment — a human-only switch on top of the approval
# queue. Paper brokers ignore it. Default (unset/0) = live routing blocked.
FIRM_ALLOW_TRADING=0
# Optional: override the execution-safety audit log path (default data/execution_audit.jsonl)
# FIRM_EXECUTION_AUDIT=data/execution_audit.jsonl

[Unit]
Description=AI Trading System API (live trading engine + web UI)
After=network.target ibgateway.service
Wants=ibgateway.service

[Service]
Type=simple
User=root
WorkingDirectory=/local/store/git/ai-trading-system
EnvironmentFile=/local/store/git/ai-trading-system/.env
# firm-api reads config/live.yaml on boot when this is set (see firm.api.routers.live).
Environment=FIRM_AUTO_START_LIVE=1
# LLM A/B experiment — arm B (llm_enhanced), switched 2026-09-08 (13 days
# short of arm A's planned 8-week/2026-09-21 end date, per explicit user
# request). See docs/llm_ab_test_runbook.md and docs/llm_ab_experiment_log.md.
Environment=FIRM_LLM_CONFIG=config/llm_ab_llm.yaml
# After=/Wants=ibgateway.service above only waits for the process to fork,
# not for IBC's headless login to actually open the API port (30-60s+) — this
# closes that race so auto-start doesn't lose to it on boot. Always exits 0
# (a readiness delay, not a hard gate); see the script for the full rationale.
ExecStartPre=/local/store/git/ai-trading-system/scripts/wait_for_ibgateway.sh
ExecStart=/local/store/git/ai-trading-system/.venv/bin/firm-api
Restart=always
# Geometric backoff (systemd >=254): 10s, 20s, 40s, 80s, then holds at 160s
# for every restart after. A single transient crash still recovers as fast
# as before (first retry unchanged at 10s); a persistent failure (bad
# config, a dead dependency) backs off instead of retrying every 10s
# forever, which would otherwise hammer whatever it's failing against
# (e.g. IB Gateway login) indefinitely. No StartLimitBurst cap on top of
# this: the broker-reconnect logic in the app itself is already
# self-healing once the underlying outage clears (see docs/PROJECT_CONTEXT.md
# "Broker & host failover"), so retrying forever at the slower ceiling is
# the right default rather than giving up and requiring a manual restart.
RestartSec=10
RestartSteps=4
RestartMaxDelaySec=160
TimeoutStopSec=120
KillMode=mixed

[Install]
WantedBy=multi-user.target
